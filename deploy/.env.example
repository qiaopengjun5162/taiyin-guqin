# 太音后端 · 生产环境变量
#
#   cp .env.example .env
#   vi .env          # 至少改 PG_PASSWORD 和 ALLOWED_ORIGINS
#
# .env 不要提交到 git（已在 .gitignore 里）。它包含数据库口令与管理口令。

# ── 数据库 ──────────────────────────────────────────────
PG_USER=taiyin
PG_DB=taiyin
# 自己生成一串强口令，别用示例值：
#   openssl rand -base64 24
PG_PASSWORD=请改成强口令

# ── 对外访问 ────────────────────────────────────────────
# 网页的 Origin（浏览器地址栏里协议+域名，不含仓库路径）。
# 只填 GitHub Pages 这一条就够；以后绑自定义域名再加，用英文逗号分隔。
ALLOWED_ORIGINS=https://qiaopengjun5162.github.io

# 后端容器在宿主机上监听的端口（只绑 127.0.0.1，反代转发到这里）
HOST_PORT=13001

# ── 管理入口（可留空）────────────────────────────────────
# 留空 = 没有管理入口。内容治理下架违规谱时才需要，填一串高熵口令：
#   openssl rand -hex 24
ADMIN_TOKEN=

# ── 找回口令邮件（生产必配）──────────────────────────────
# 自助找回口令要把一次性重置链接寄到注册邮箱。不配 SMTP_HOST 时邮件只进
# 容器日志、不真发出——找回等于没通，只能走管理员重置兜底。
# 多数邮箱的 SMTP_PASSWORD 填的是「授权码」（邮箱设置里生成），不是登录口令。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人；部分邮箱要求与 SMTP 账号同域，如：太音古琴 <noreply@your-domain>
MAIL_FROM=
# 重置链接的站点前缀。默认 GitHub Pages；换前端部署时改成新地址，
# 否则邮件里的链接会指到旧站。
APP_BASE_URL=https://qiaopengjun5162.github.io/taiyin-guqin

# ── AI 能力（可留空）─────────────────────────────────────
# 不填：AI 减字识别与「AI 优选」不可用，其余功能正常。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 如需走代理网关（例如自建中转），填它；直连官方留空即可。
ANTHROPIC_BASE_URL=
TRANSLATE_API_KEY=

# ── 镜像版本 ────────────────────────────────────────────
# latest = 最新成功构建；回滚时改成上一个 sha 短码（如 sha-0589f0c）
IMAGE_TAG=latest

RUST_LOG=info

# ── 容器名（可留空）────────────────────────────────────
# 一台机器上要同时跑「生产」和「本地试验」两套时，给试验那套换个名字，
# 否则第二次 `up` 会撞名失败（Container name already in use）。
PG_NAME=
SERVER_NAME=

# ── AI 识别走 OpenAI 兼容渠道（可选，与 ANTHROPIC_* 二选一）──────
# LLM_API_STYLE=openai 时识别用下面这套（如 DeepSeek）。
# ⚠️ 模型必须支持看图（DeepSeek 用 deepseek-flash；deepseek-v4-pro 只看文本，
# 选错不报错，只会得到空识别）。OPENAI_DISABLE_THINKING 默认开，别关：
# 推理型模型开着思考会把 max_tokens 全烧在思考上，content 恒为空。
LLM_API_STYLE=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_MODEL=deepseek-flash
