# ===== taiyin-server（后端）=====
DATABASE_URL=postgres://taiyin:taiyin_dev@localhost:5432/taiyin
HOST=0.0.0.0
PORT=3001

# CORS 允许来源（逗号分隔）。
# 留空 = 开发态放开（仅本地）。
# 生产必须设置，例如：https://taiyin.example.com
ALLOWED_ORIGINS=

# 可选 API-key 闸门（纵深防御）：设置后 /translate/select 需携带此 key。
# 注意：此 key 不应视为机密，前端包会包含它。
TRANSLATE_API_KEY=

# 限流（每客户端 IP）
GLOBAL_RATE_PER_SECOND=2
GLOBAL_RATE_BURST=60
TRANSLATE_RATE_PER_SECOND=1
TRANSLATE_RATE_BURST=5

# Anthropic（未配置则 /translate/select 回退启发式 top1）
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# 可选：覆盖 Anthropic Messages API 端点（指向兼容代理/网关时用，如自建 Claude 兼容服务）
ANTHROPIC_BASE_URL=

# ── AI 减字识别：后端风格切换 ───────────────────────────────────────
# 默认 anthropic（走上面 ANTHROPIC_*）。改为 openai 可复用 OpenAI 兼容网关
# （DeepSeek / OpenRouter / 各类 Claude 兼容代理），无需 Anthropic 官方 key。
#
# ⚠️ 模型必须支持「图片输入」。以 DeepSeek 端点为例（GET /v1/models 可查
#    input_modalities）：
#      deepseek-flash    → ["text","image"]  ✅ 视觉可用（默认）
#      deepseek-v4-pro   → ["text"]          ❌ 纯文本，喂图会得到「看不到图片」
#    选错型号不会报错，只会静默返回空识别——这是最容易踩的坑。
LLM_API_STYLE=anthropic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_MODEL=deepseek-flash
# 关闭「思考」：推理型视觉模型开着思考会把 max_tokens 全烧在推理上，
# content 恒为空（finish_reason=length）。默认 true；网关不认识该字段会自动去掉重试。
# 设 0/false 可恢复默认思考行为。
OPENAI_DISABLE_THINKING=true

# ── 减字识别：模板匹配（电子谱面专用，非视觉）─────────────────────
# 对本项目字体渲染的干净减字图，模板匹配 exact_match 100%（字高 ≥72px、
# 确定性、零成本），优于任何通用视觉模型（42 条基线上 LLM 为 0%）。
# 同一策略作用于单字 /recognize 与整页 /recognize-sheet（整页走切分+逐格匹配，
# 间隙 ≥0.2×字高时切分全对）。拍照/扫描件不适用，会自动落 LLM。
#   auto     （默认）：模板置信度达标用模板，否则走 LLM；LLM 未配置时用模板兜底
#   template ：只用模板匹配
#   llm      ：只用视觉大模型（维持旧行为，未配置 key 时 503）
RECOGNIZE_MODE=auto
# auto 模式接受模板结果的最低置信度（top-2 margin 比 = 1 - d1/d2）。默认 0.3。
RECOGNIZE_TEMPLATE_MIN_MARGIN=0.3

