# 太音 · 后端环境变量示例
# 复制为 .env 后按需修改

# PostgreSQL 连接字符串
DATABASE_URL=postgres://taiyin:taiyin_dev@localhost:5432/taiyin

# 服务监听地址与端口
HOST=0.0.0.0
PORT=3001

# Anthropic LLM（用于 /api/v1/translate/select AI 候选择优）
# 未配置或为空时自动回退启发式 top1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 日志级别（可选）
RUST_LOG=info
