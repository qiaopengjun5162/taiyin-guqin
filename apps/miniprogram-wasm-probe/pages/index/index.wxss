.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 64rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 32rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 1.25;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 28rpx;
}

.verdict {
    box-sizing: border-box;
    display: flex;
    margin-bottom: 28rpx;
    padding: 28rpx 32rpx;
    border: 2rpx solid;
    border-radius: 20rpx;
    flex-direction: column;
}

.verdict-pending {
    border-color: #cfe0ff;
    background: #eef4ff;
}

.verdict-pass {
    border-color: #b9e6c9;
    background: #e8f7ee;
}

.verdict-fail {
    border-color: #ffcfcc;
    background: #fff0ef;
}

.verdict-label {
    font-size: 46rpx;
    font-weight: 700;
    letter-spacing: 4rpx;
}

.verdict-pending .verdict-label {
    color: #1769e0;
}

.verdict-pass .verdict-label {
    color: #137a43;
}

.verdict-fail .verdict-label {
    color: #c0342b;
}

.verdict-text {
    margin-top: 8rpx;
    color: #1f2329;
    font-size: 28rpx;
}

.verdict-hint {
    margin-top: 8rpx;
    color: #646a73;
    font-size: 24rpx;
    line-height: 1.6;
    word-break: break-all;
}

.state-card,
.content-card,
.demo-panel {
    box-sizing: border-box;
    padding: 36rpx;
    border: 2rpx solid #e5e8eb;
    border-radius: 24rpx;
    background: #ffffff;
}

.state-card {
    display: flex;
    min-height: 320rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}

.state-card-error {
    border-color: #ffd8d6;
}

.spinner {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #dbe8fb;
    border-top-color: #1769e0;
    border-radius: 50%;
}

.state-icon {
    color: #1769e0;
    font-size: 56rpx;
    font-weight: 700;
}

.state-title,
.section-title {
    margin-top: 20rpx;
    font-size: 34rpx;
    font-weight: 600;
}

.state-description,
.section-description {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.primary-button {
    margin-top: 28rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 28rpx;
}

.feature-list {
    margin-top: 32rpx;
}

.feature-item {
    display: flex;
    align-items: center;
    padding: 20rpx 0;
    border-top: 2rpx solid #f0f1f2;
}

.feature-index {
    display: flex;
    width: 44rpx;
    height: 44rpx;
    align-items: center;
    border-radius: 50%;
    background: #eaf2ff;
    color: #1769e0;
    font-size: 24rpx;
    justify-content: center;
}

.feature-text {
    margin-left: 20rpx;
    font-size: 28rpx;
}

.row-body {
    display: flex;
    margin-left: 20rpx;
    flex: 1;
    flex-direction: column;
}

.row-name {
    color: #1769e0;
    font-size: 26rpx;
    font-weight: 600;
}

.row-text {
    margin-top: 8rpx;
    color: #646a73;
    font-size: 22rpx;
    line-height: 1.6;
    word-break: break-all;
}

.demo-panel {
    margin-top: 24rpx;
}

.demo-title {
    font-size: 28rpx;
    font-weight: 600;
}

.demo-actions {
    display: flex;
    margin-top: 20rpx;
    flex-wrap: wrap;
}

.demo-button {
    margin: 0 16rpx 16rpx 0;
    background: #f2f3f5;
    color: #1f2329;
}
