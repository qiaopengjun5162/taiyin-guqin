{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "env": {
    "BASE_PATH": "",
    "PNPM_VERSION": "11"
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
