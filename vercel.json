{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --ignore-scripts",
  "buildCommand": "bash scripts/build-static.sh",
  "outputDirectory": "apps/web/dist",
  "env": {
    "BASE_PATH": ""
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
