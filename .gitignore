# Python 评估脚本运行产生的字节码缓存
__pycache__/
*.pyc


# ts-rs 自动测试可能写出的默认 bindings 目录（真实生成物在 apps/web/src/lib/generated/）
bindings/

# eval harness 生成的冒烟产物（可由 gen_smoke.py 再生，勿提交）
tools/eval-jianzi/annotations/smoke_*.json
tools/eval-jianzi/images/
tools/eval-jianzi/annotations/font_cases.json
# 模板匹配的中间产物（build/predict 再生；Rust 索引在 crates/taiyin-server/data/）
tools/eval-jianzi/.cache/
tools/eval-jianzi/annotations/font_cases_tpl.json
tools/eval-jianzi/annotations/sheet_cases.json

# moonpub 本地产物（预览接收人等）
.moonpub/

# moonpub 发布产物（.md 源文件才是要提交的）
docs/articles/drafts/*.draft.json
docs/articles/drafts/*.html

# 生产部署的数据库数据卷（备份对象，不进版本库）
deploy/pgdata/
